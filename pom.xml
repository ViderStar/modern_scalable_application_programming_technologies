<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>by.bsuir.bank</groupId>
    <artifactId>bank</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>bank</name>
    <description>Информационная система условного банка: микросервисы на Java + Spring</description>

    <modules>
        <module>ui-kit</module>
        <module>bank-common</module>
        <module>client-service</module>
        <module>account-service</module>
        <module>deposit-service</module>
        <module>credit-service</module>
        <module>atm-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <vue.version>3.5.13</vue.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>by.bsuir.bank</groupId>
                <artifactId>ui-kit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>by.bsuir.bank</groupId>
                <artifactId>bank-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.webjars.npm</groupId>
                <artifactId>vue</artifactId>
                <version>${vue.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- *Test — модульные тесты (фаза test), *IT — интеграционные и функциональные (фаза verify) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
